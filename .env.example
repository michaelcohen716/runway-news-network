# ── Runway News Network — environment ───────────────────────────────────────
# Copy to .env and fill in. Each stage validates only the keys it needs, so you
# can run the scaffold/healthcheck and early steps before every key is set.

# Quality tier: "draft" (cheap, default) or "final" (expensive models)
QUALITY_TIER=draft

# Production "final-only" mode: when "true", draft generation is forced to final,
# the quality toggle is hidden, and only final-tier segments are watchable.
NEXT_PUBLIC_RNN_FINAL_ONLY=false

# Supabase — persistence for inputs, components, logs, and video storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Personal access token — only for the Supabase MCP server (not used by the app)
SUPABASE_ACCESS_TOKEN=

# Runway API — images (nano banana), image-to-video, lip sync (Steps 4–6)
RUNWAY_API_KEY=

# Anthropic — article deconstruction + storyboard (Step 2)
ANTHROPIC_API_KEY=

# ElevenLabs — TTS narration (Step 3)
ELEVENLABS_API_KEY=
TTS_VOICE_ID=

# Optional: scraper API fallback for paywalled / JS-heavy articles (Step 1)
SCRAPER_API_KEY=

# Worker tuning
WORKER_POLL_MS=3000

# Runway TTS preset voice (provider=runway). e.g. Rachel, Eleanor, Serene, Sandra
RUNWAY_TTS_VOICE=Rachel

# Final-tier access password — required to generate final videos (prod gate).
# Leave empty to ungate (local dev). Set to a secret value in production.
RNN_FINAL_PASSWORD=
